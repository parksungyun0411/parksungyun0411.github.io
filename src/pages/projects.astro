---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { projects } from "../data/projects";

const allTabs = [
  { id: "work", label: "Work" },
  { id: "personal", label: "Personal" },
  { id: "contest", label: "Contest" },
  { id: "academic", label: "Academic" },
] as const;

const grouped = {
  work: projects.filter((p) => p.category === "work"),
  personal: projects.filter((p) => p.category === "personal"),
  contest: projects.filter((p) => p.category === "contest"),
  academic: projects.filter((p) => p.category === "academic"),
};

// 공개 항목이 없는 탭은 숨긴다 (예: 개인 프로젝트를 모두 draft로 돌린 경우)
const tabs = allTabs.filter((t) => grouped[t.id].length > 0);
---

<BaseLayout
  title="Projects · 박성윤"
  description="박성윤의 프로젝트 모음 — 실무 프로젝트, 개인 프로젝트, 공모전, 학부 프로젝트."
  sideBarActiveItemID="projects"
>
  <div>
    <div class="text-3xl w-full font-bold mb-2">Projects</div>
    <p class="text-sm opacity-70 mb-5">카드를 누르면 프로젝트 상세 페이지로 이동합니다.</p>
  </div>

  <div role="tablist" class="tabs tabs-bordered tabs-lg mb-6 text-base md:text-lg font-semibold overflow-x-auto whitespace-nowrap">
    {
      tabs.map((t, i) => (
        <button
          role="tab"
          class={`tab${i === 0 ? " tab-active" : ""}`}
          data-tab={t.id}
        >
          {t.label}
        </button>
      ))
    }
  </div>

  <div class="tab-stack">
    {
      tabs.map((t, i) => (
        <section data-tab-content={t.id} class={i === 0 ? "active" : ""}>
          <div class="grid gap-4">
            {grouped[t.id].map((p) => (
              <HorizontalCard
                title={p.title}
                desc={p.summary}
                url={`/projects/${p.slug}/`}
                badge={p.badge}
                result={p.result}
                hero={p.hero}
                color={p.color}
              />
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <script is:inline>
    document.querySelectorAll('[data-tab]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const target = btn.dataset.tab;
        document.querySelectorAll('[data-tab]').forEach((b) => {
          b.classList.toggle('tab-active', b === btn);
        });
        document.querySelectorAll('[data-tab-content]').forEach((c) => {
          c.classList.toggle('active', c.dataset.tabContent === target);
        });
      });
    });
  </script>
</BaseLayout>
