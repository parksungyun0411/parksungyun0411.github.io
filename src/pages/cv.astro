---
import BaseLayout from "../layouts/BaseLayout.astro";
import { featuredProjects, projects } from "../data/projects";

const skills = [
  {
    area: "Development",
    items: ["TypeScript", "Python", "React", "Next.js", "Node.js·Express", "FastAPI", "PostgreSQL·SQL", "Drizzle ORM", "MongoDB", "Neo4j", "Redis", "SSE·WebSocket", "Java"],
  },
  {
    area: "AI · Data",
    items: ["PyTorch", "HuggingFace", "scikit-learn", "KR-BERT", "KoELECTRA", "DAPT", "RAG", "Graph-RAG (Neo4j)", "LangChain", "LangGraph", "GPT-4o API", "몬테카를로 시뮬레이션"],
  },
  {
    area: "QA · Test",
    items: ["테스트 설계·TDD", "회귀·정합성 검증", "Playwright", "권한·보안 경계 테스트", "테스트 시드 자동화", "버그리포트·재현 케이스"],
  },
  {
    area: "Infra · Tools",
    items: ["AWS (EC2)", "Azure (Entra ID·M365)", "Docker", "GitHub Actions", "Git·GitHub", "Jira·Confluence", "GA4·GTM", "Figma"],
  },
];

const experience = [
  {
    company: "데이콘",
    role: "운영·개발 파트 (서비스 기획 · 풀스택 개발 · QA)",
    period: "2026.04 – 현재",
    summary: "AI 경진대회 플랫폼의 평가 시스템을 기획부터 배포까지 맡고, 플랫폼 전반의 주간 QA를 담당하고 있습니다. 활동량은 작성 PR 32건(머지 23건), 고유 커밋 357건입니다(2026-09-15 저장소 실측).",
    bullets: [
      "평가설정 시퀀스 재설계 — 설정 화면을 세 갈래로 나누고 평가 단계가 설정을 주도하게 바꿔, 데이터 구조를 바꾸지 않고 다차수 평가를 지원. 테스트 31/31 통과 후 배포",
      "역할별 ELO 정규화 룰 설계 — 62팀 규모 월간 해커톤에 적용. 자사 수식으로 시뮬레이션해 순위 신뢰 기준선(최소 3,000매치)을 산출하고, 이를 근거로 투표 가산점 안을 기각한 뒤 호혜 게이트를 구현",
      "출시 전 검증 — ELO 동시 재계산으로 갱신이 사라지던 문제와 투표 대상 검증 누락을 차단하고, 블라인드 평가의 팀명 노출 경로를 개인정보 문제로 보고 먼저 차단",
      "주간 체크리스트 QA 최소 86회차 — 통과 여부 대신 재현 조건을 화면 폭 단위로 기록하고, 확인하지 못한 항목은 검증 한계로 명시. QA 준비를 시드 커맨드로 자동화",
      "교통사고 위험 예측 AI 플랫폼 개발·배포 (NIA 정책 수립 지원 데이터 분석 사업) — 외부망이 분리된 PC용 오프라인 설치 패키지를 만들고, 현장 보안 프로그램이 설치를 막자 파일 단위 복사 방식으로 재작성",
    ],
  },
  {
    company: "자빅스",
    role: "클라우드·엔터프라이즈 서비스 운영팀 인턴",
    period: "2025.05 – 2025.08",
    summary: "AWS·Azure 기반 클라우드 서비스 운영과 공공 메신저 서비스 기획을 지원했습니다.",
    bullets: [
      "고객사 EC2 인스턴스 생성·확장 요청을 처리하고, 사용량을 분석해 과금을 산정한 뒤 어드민·재무 담당자에게 전달",
      "Azure AD(Entra ID) 기반 계정 체계와 Microsoft 365 운영 보조, 단말 배포 체계 구축 지원",
      "사용자 약 15만 명 규모 공공 메신저의 조직도 기반 사용자 조회·대화방 기능 기획 참여, 행정 시스템 연계 구조와 통합 알림 서비스 기획안 정리",
    ],
  },
  {
    company: "갈매 시그마 수학학원",
    role: "수학 강사 (아르바이트)",
    period: "2019.12 – 2026.04",
    summary: "초등부터 고3까지 지도했습니다(군 복무 기간 제외).",
    bullets: [
      "학생이 막힌 선행 개념까지 되짚어 다시 쌓는 방식으로 지도 — 이 경험이 진단 결과로 취약 개념을 짚어 학습 경로를 제안하는 너드수학 설계로 이어짐",
    ],
  },
];

const certifications = [
  "정보처리기사 · 2025.12",
  "빅데이터분석기사 · 2025.12",
  "ADsP · 2025.06",
  "SQLD · 2024.09",
  "컴퓨터활용능력 1급 · 2024.04",
  "한국사능력검정시험 1급 · 2023.08",
  "TOEIC 885 · 2024.08",
  "TOEIC Speaking IM3 (130) · 2026.03",
];
---

<BaseLayout
  title="CV · 박성윤"
  description="박성윤 | Park Sungyun의 이력 — 기술 스택, 경력, 대표 프로젝트, 학력, 자격증·어학."
  sideBarActiveItemID="cv"
>
  <!-- Header -->
  <header class="cv-header mb-10">
    <p class="text-xs font-mono opacity-60 tracking-widest uppercase mb-2">Curriculum Vitae</p>
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div class="grow">
        <h1 class="text-4xl md:text-5xl font-bold leading-tight tracking-tight">박성윤</h1>
        <p class="text-xl md:text-2xl mt-1 opacity-80 font-light">Park Sungyun</p>
        <p class="mt-4 text-base md:text-lg font-semibold break-keep">서비스 기획 · QA | 풀스택 · AI/Data 개발</p>
      </div>
      <button
        type="button"
        class="btn btn-sm btn-outline print:hidden"
        onclick="window.print()"
        aria-label="이력서 인쇄"
      >
        Print
      </button>
    </div>

    <dl id="contact" class="cv-meta mt-6 grid grid-cols-1 md:grid-cols-3 gap-x-6 gap-y-2 text-sm border-t border-b border-base-300 py-4">
      <div class="flex gap-2">
        <dt class="opacity-50 font-mono uppercase tracking-wide w-16 shrink-0">Email</dt>
        <dd>
          <a href="mailto:psyreo@naver.com" class="link link-hover">psyreo@naver.com</a>
        </dd>
      </div>
      <div class="flex gap-2">
        <dt class="opacity-50 font-mono uppercase tracking-wide w-16 shrink-0">GitHub</dt>
        <dd>
          <a href="https://github.com/parksungyun0411" target="_blank" rel="noopener" class="link link-hover">github.com/parksungyun0411</a>
        </dd>
      </div>
      <div class="flex gap-2">
        <dt class="opacity-50 font-mono uppercase tracking-wide w-16 shrink-0">Velog</dt>
        <dd>
          <a href="https://velog.io/@parksungyun0411" target="_blank" rel="noopener" class="link link-hover">@parksungyun0411</a>
        </dd>
      </div>
      <div class="flex gap-2">
        <dt class="opacity-50 font-mono uppercase tracking-wide w-16 shrink-0">Based</dt>
        <dd>Seoul, South Korea</dd>
      </div>
      <div class="flex gap-2">
        <dt class="opacity-50 font-mono uppercase tracking-wide w-16 shrink-0">Now</dt>
        <dd>데이콘 · 운영·개발 파트</dd>
      </div>
      <div class="flex gap-2">
        <dt class="opacity-50 font-mono uppercase tracking-wide w-16 shrink-0">Edu</dt>
        <dd>건국대 · 스마트ICT융합공학</dd>
      </div>
    </dl>
  </header>

  <!-- Summary -->
  <section class="cv-section mb-10">
    <h2 class="cv-h">Summary</h2>
    <p class="opacity-90 leading-relaxed break-keep">
      데이터와 AI로 사용자의 본질적인 문제를 찾아 해결하는 엔지니어입니다.
      현재 데이콘에서 AI 경진대회 플랫폼의 평가 시스템을 기획·설계부터 구현·테스트·배포까지 직접 수행하고,
      플랫폼 전반의 QA와 자동화를 담당합니다. 학부에서는 스마트ICT융합공학과 응용통계학을 함께 전공했고,
      제주어 감정 분류 졸업 프로젝트에서 데이터 구축부터 모델 실험까지 맡았습니다.
    </p>
  </section>

  <!-- Skills -->
  <section class="cv-section mb-10">
    <h2 class="cv-h">Skills</h2>
    <div class="grid gap-2.5">
      {
        skills.map((row) => (
          <div class="grid grid-cols-1 md:grid-cols-[8rem_1fr] gap-1 md:gap-3 items-baseline">
            <div class="text-sm font-semibold opacity-70">{row.area}</div>
            <div class="flex flex-wrap gap-1.5">
              {row.items.map((s) => (
                <span class="badge badge-outline font-mono text-xs">{s}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
    <p class="text-xs opacity-60 mt-3">사용 맥락은 각 프로젝트 상세와 경력 항목에 있습니다.</p>
  </section>

  <!-- Work Experience -->
  <section class="cv-section mb-10">
    <h2 class="cv-h">Work Experience</h2>
    <div class="grid gap-6">
      {
        experience.map((job) => (
          <div class="cv-entry">
            <div class="flex items-baseline justify-between gap-4 flex-wrap">
              <h3 class="text-lg font-bold">
                {job.company} <span class="font-normal opacity-80">· {job.role}</span>
              </h3>
              <span class="font-mono text-sm opacity-60 shrink-0">{job.period}</span>
            </div>
            <p class="text-sm opacity-75 mt-1">{job.summary}</p>
            <ul class="cv-bullets">
              {job.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="cv-section mb-10">
    <h2 class="cv-h">Featured Projects</h2>
    <div class="grid gap-4">
      {
        featuredProjects.map((p) => (
          <div class="cv-entry">
            <div class="flex items-baseline justify-between gap-4 flex-wrap">
              <h3 class="font-bold">
                <a href={`/projects/${p.slug}/`} class="link link-hover">{p.title}</a>
              </h3>
              <span class="font-mono text-sm opacity-60 shrink-0">{p.period}</span>
            </div>
            <p class="text-sm opacity-75 mt-1 leading-relaxed">{p.summary}</p>
          </div>
        ))
      }
    </div>
    <p class="text-xs opacity-60 mt-3 print:hidden">
      전체 {projects.length}개 프로젝트의 배경·접근·결과는 <a href="/projects" class="link">Projects</a>에 있습니다.
    </p>
  </section>

  <!-- Education -->
  <section class="cv-section mb-10">
    <h2 class="cv-h">Education</h2>
    <div class="cv-entry">
      <div class="flex items-baseline justify-between gap-4 flex-wrap">
        <h3 class="font-bold">건국대학교 · 스마트ICT융합공학과 주전공 · 응용통계학과 복수전공 · 학사</h3>
        <span class="font-mono text-sm opacity-60 shrink-0">2020.03 – 2026.02</span>
      </div>
    </div>
  </section>

  <!-- Certifications & Languages -->
  <section class="cv-section mb-10">
    <h2 class="cv-h">Certifications &amp; Languages</h2>
    <ul class="cv-bullets">
      {certifications.map((c) => <li>{c}</li>)}
    </ul>
  </section>
</BaseLayout>
