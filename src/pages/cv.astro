---
import BaseLayout from "../layouts/BaseLayout.astro";
import { featuredProjects } from "../data/projects";

const skills = [
  {
    area: "LLM · Agent",
    items: ["LangChain", "LangGraph", "OpenAI API", "RAG · Graph-RAG", "Neo4j"],
  },
  {
    area: "ML · 데이터",
    items: ["PyTorch", "HuggingFace Transformers", "scikit-learn", "LightGBM", "SHAP", "pandas", "SQL"],
  },
  {
    area: "서빙 · 인프라",
    items: ["FastAPI", "Node.js · Express", "PostgreSQL", "MongoDB", "Redis", "Docker", "GitHub Actions", "AWS EC2", "Nginx"],
  },
  {
    area: "웹 · 테스트",
    items: ["React", "Next.js", "TypeScript", "Playwright"],
  },
];

const experience = [
  {
    company: "데이콘",
    role: "운영·개발 파트 (서비스 기획 · 풀스택 개발 · QA)",
    period: "2026.04 – 현재",
    summary: "AI 해커톤 플랫폼의 평가 시스템을 기획하고 구현해 운영에 반영했고, 공공기관 납품 플랫폼의 운영·유지보수와 플랫폼 전반의 주간 QA, 경진대회 현장 운영 보조를 함께 합니다.",
    bullets: [
      "공공기관 납품 교통사고 위험 예측 AI 플랫폼 개발·배포 (2026.09 – 현재, NIA 정책 수립 지원 데이터 분석 사업): 인수 후 운영·유지보수를 맡아 인수인계 패키지를 분석하고 보류 목록의 우선순위를 정했으며, 발주기관 재요청에 대응해 화면마다 다른 검사를 보이던 문제를 대표 검사 선정 한 곳으로 모아 고친 v9.4.0 배포본을 빌드",
      "해커톤 평가 설정 재설계: 기획서를 써서 합의를 받고, 설정 화면을 세 부분으로 나눈 뒤 설정을 평가 단계에서 읽도록 고쳐 동료 리뷰를 거쳐 운영에 반영",
      "ELO 대중평가: 채널별 정규화 규칙 설계(구현은 동료), 영역별 결함 감사와 수정, 자사 수식을 그대로 쓴 시뮬레이션으로 순위 신뢰 기준(제출물 300개 가정, 합성 데이터에서 총 3,000매치) 산출, 투표 가산점 안을 기각하고 호혜 게이트 구현",
      "플랫폼 주간 QA(약 14주 동안 QA 티켓 86건)와 QA 준비 자동화, 대학 연합 경진대회 본선 현장 운영 보조와 공공기관 경진대회 온라인 설명회 발표",
    ],
  },
  {
    company: "자빅스",
    role: "클라우드·엔터프라이즈 서비스 운영팀 (인턴)",
    period: "2025.05 – 2025.08",
    summary: "고객사 AWS 요청 사항을 정리하고 사용량을 분석해 과금을 산정했으며, 공공 메신저 기능 기획에 참여했습니다.",
    bullets: [
      "고객사 AWS 요청 사항 정리, 사용 내역 분석으로 과금 산정 후 어드민 전달",
      "Azure Entra ID 계정 체계와 Microsoft 365 운영 보조",
      "사용자 약 15만 명 규모 공공 메신저의 조직도 기반 사용자 조회·대화방 기능 기획 참여, 통합 알림 트리거 서비스 기획의 화면 UI 보조",
    ],
  },
];

const activities = [
  { title: "한이음 드림업 (정보통신기획평가원 ICT 멘토링) · 너드수학 AI 백엔드 개발 · 4인 팀", date: "2025.04 – 2025.11" },
  { title: "갈매 시그마 수학학원 · 수학 강사 (초등 ~ 고3, 군 복무 기간 제외)", date: "2019.12 – 2026.04" },
  { title: "육군 병장 만기전역", date: "2021.04 – 2022.10" },
];
---

<BaseLayout
  title="CV · 박성윤"
  description="박성윤 | Park Sungyun의 이력: 기술 스택, 경력, 대표 프로젝트, 학력, 자격증·어학, 활동."
  sideBarActiveItemID="cv"
>
  <!-- Header -->
  <header class="cv-header mb-10">
    <p class="text-xs font-mono opacity-60 tracking-widest uppercase mb-2">Curriculum Vitae</p>
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div class="grow">
        <h1 class="text-4xl md:text-5xl font-bold leading-tight tracking-tight">박성윤</h1>
        <p class="text-xl md:text-2xl mt-1 opacity-80 font-light">Park Sungyun</p>
        <p class="mt-4 text-base md:text-lg font-semibold break-keep">데이터가 들어와서 쓰이기까지의 길을 만들고, 그 길이 어디서 끊기는지 먼저 찾습니다.</p>
      </div>
      <button
        type="button"
        class="btn btn-sm btn-outline print:hidden"
        onclick="window.print()"
        aria-label="이력서 인쇄"
      >
        Print
      </button>
    </div>

    <dl class="cv-meta mt-6 grid grid-cols-1 md:grid-cols-3 gap-x-6 gap-y-2 text-sm border-t border-b border-base-300 py-4">
      <div class="flex gap-2">
        <dt class="opacity-50 font-mono uppercase tracking-wide w-16 shrink-0">Email</dt>
        <dd>
          <a href="mailto:psyreo@naver.com" class="link link-hover">psyreo@naver.com</a>
        </dd>
      </div>
      <div class="flex gap-2">
        <dt class="opacity-50 font-mono uppercase tracking-wide w-16 shrink-0">GitHub</dt>
        <dd>
          <a href="https://github.com/parksungyun0411" target="_blank" rel="noopener" class="link link-hover">github.com/parksungyun0411</a>
        </dd>
      </div>
      <div class="flex gap-2">
        <dt class="opacity-50 font-mono uppercase tracking-wide w-16 shrink-0">Based</dt>
        <dd>Seoul, South Korea</dd>
      </div>
      <div class="flex gap-2">
        <dt class="opacity-50 font-mono uppercase tracking-wide w-16 shrink-0">Now</dt>
        <dd>데이콘 · 운영·개발 파트</dd>
      </div>
      <div class="flex gap-2">
        <dt class="opacity-50 font-mono uppercase tracking-wide w-16 shrink-0">Edu</dt>
        <dd>건국대 · 스마트ICT융합공학과 · 응용통계학과</dd>
      </div>
      <div class="flex gap-2">
        <dt class="opacity-50 font-mono uppercase tracking-wide w-16 shrink-0">Service</dt>
        <dd>군필 (육군 병장 만기전역)</dd>
      </div>
    </dl>
  </header>

  <!-- Summary -->
  <section class="cv-section mb-10">
    <h2 class="cv-h">Summary</h2>
    <p class="opacity-90 leading-relaxed">
      기획부터 구현, 검증, 배포까지 한 흐름으로 맡는 데이터·AI 백엔드 엔지니어입니다.
      학부에서 스마트ICT융합공학과 응용통계학을 함께 전공했고, 한이음 AI 수학 튜터의 Graph-RAG 추천 엔진과 추론 서버,
      졸업 프로젝트의 제주어 감정 분류 데이터 구축과 모델 설계를 거쳐, 지금은 데이콘에서 AI 해커톤 플랫폼의 평가 시스템을 기획·개발하고
      플랫폼 전반의 주간 QA를 맡고 있습니다. 공공기관 납품 교통사고 위험 예측 플랫폼은 2026년 9월 인수해 운영·유지보수를 맡고 있습니다.
      졸업 프로젝트는 졸업 뒤 다시 검증해 데이터 누수와 라벨 이름 뒤바뀜을 찾았고, 문장 단위로 다시 나눠 재평가하고 있습니다.
      근거 없는 주장을 쓰지 않으려고 하고, 순위를 믿어도 되는지 궁금하면 시뮬레이션을 돌려 숫자를 만듭니다.
    </p>
  </section>

  <!-- Skills -->
  <section class="cv-section mb-10">
    <h2 class="cv-h">Skills</h2>
    <div class="grid gap-2.5">
      {
        skills.map((row) => (
          <div class="grid grid-cols-1 md:grid-cols-[8rem_1fr] gap-1 md:gap-3 items-baseline">
            <div class="text-sm font-semibold opacity-70">{row.area}</div>
            <div class="flex flex-wrap gap-1.5">
              {row.items.map((s) => (
                <span class="badge badge-outline font-mono text-xs">{s}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
    <p class="text-xs opacity-60 mt-3">실제 프로젝트에서 사용한 기술만 적었습니다. 사용 맥락은 각 프로젝트 상세에 있습니다.</p>
  </section>

  <!-- Work Experience -->
  <section class="cv-section mb-10">
    <h2 class="cv-h">Work Experience</h2>
    <div class="grid gap-6">
      {
        experience.map((job) => (
          <div class="cv-entry">
            <div class="flex items-baseline justify-between gap-4 flex-wrap">
              <h3 class="text-lg font-bold">
                {job.company} <span class="font-normal opacity-80">· {job.role}</span>
              </h3>
              <span class="font-mono text-sm opacity-60 shrink-0">{job.period}</span>
            </div>
            <p class="text-sm opacity-75 mt-1">{job.summary}</p>
            <ul class="cv-bullets">
              {job.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="cv-section mb-10">
    <h2 class="cv-h">Featured Projects</h2>
    <div class="grid gap-4">
      {
        featuredProjects.map((p) => (
          <div class="cv-entry">
            <div class="flex items-baseline justify-between gap-4 flex-wrap">
              <h3 class="font-bold">
                <a href={`/projects/${p.slug}/`} class="link link-hover">{p.title}</a>
              </h3>
              <span class="font-mono text-sm opacity-60 shrink-0">{p.period}</span>
            </div>
            <p class="text-sm opacity-75 mt-1 leading-relaxed">{p.summary}</p>
          </div>
        ))
      }
    </div>
    <p class="text-xs opacity-60 mt-3 print:hidden">
      전체 프로젝트의 배경·접근·결과는 <a href="/projects" class="link">Projects</a>에 있습니다.
    </p>
  </section>

  <!-- Education -->
  <section class="cv-section mb-10">
    <h2 class="cv-h">Education</h2>
    <div class="cv-entry">
      <div class="flex items-baseline justify-between gap-4 flex-wrap">
        <h3 class="font-bold">건국대학교 · 스마트ICT융합공학과 주전공 · 응용통계학과 복수전공 · 학사</h3>
        <span class="font-mono text-sm opacity-60 shrink-0">2020.03 – 2026.02</span>
      </div>
      <p class="text-sm opacity-75 mt-1">
        평점 4.10 / 4.5 · 졸업 프로젝트: 제주어 다중감정분류 · 관련 과목: 자료구조, 알고리즘, 데이터베이스, 시스템 프로그래밍, 네트워크 프로그래밍, 통계전산처리, 회귀분석, 비모수통계, 다변량 자료분석
      </p>
    </div>
  </section>

  <!-- Certifications & Languages -->
  <section class="cv-section mb-10">
    <h2 class="cv-h">Certifications &amp; Languages</h2>
    <ul class="cv-bullets">
      <li>정보처리기사 · 한국산업인력공단 · 2025.12</li>
      <li>빅데이터분석기사 · 한국데이터산업진흥원 · 2025.12</li>
      <li>데이터분석 준전문가 (ADsP) · 한국데이터산업진흥원 · 2025.06</li>
      <li>SQL 개발자 (SQLD) · 한국데이터산업진흥원 · 2024.09</li>
      <li>컴퓨터활용능력 1급 · 대한상공회의소 · 2024.04</li>
      <li>한국사능력검정시험 1급 · 국사편찬위원회 · 2023.08</li>
      <li>TOEIC Speaking Test · Intermediate Mid 3 (130점) · 2026.03</li>
      <li>TOEIC · 885점 · 2024.08</li>
    </ul>
  </section>

  <!-- Activities -->
  <section class="cv-section mb-10">
    <h2 class="cv-h">Activities</h2>
    <div class="grid gap-2">
      {
        activities.map((a) => (
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <span class="text-sm opacity-85">{a.title}</span>
            <span class="font-mono text-xs opacity-60 shrink-0">{a.date}</span>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
